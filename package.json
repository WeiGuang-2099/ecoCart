{
  "name": "ecocart",
  "version": "1.0.0",
  "description": "Supermarket Carbon Footprint Scanner - Identify product barcodes and calculate carbon footprint",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,md}\" --ignore-path .prettierignore",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "^1.24.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "carbon-footprint",
    "barcode-scanner",
    "eco-friendly"
  ],
  "author": "EcoCart Team",
  "license": "MIT"
}
