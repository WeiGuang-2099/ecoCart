{
  "name": "ecocart",
  "version": "1.0.0",
  "description": "Supermarket Carbon Footprint Scanner - Identify product barcodes and calculate carbon footprint",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,md}\" --ignore-path .prettierignore"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.1",
    "jimp": "^1.6.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.1"
  },
  "keywords": [
    "carbon-footprint",
    "barcode-scanner",
    "eco-friendly"
  ],
  "author": "EcoCart Team",
  "license": "MIT"
}
